extends Node2D

# Kecepatan gerak ular
var MOVE_SPEED := 0.15
var move_timer := 0.0

# Referensi ke SnakeContainer
@onready var snake = $SnakeContainer

func _process(delta):
	# Handle input
	if Input.is_action_pressed("ui_right"):
		snake.set_next_direction(Vector2(1, 0))
	elif Input.is_action_pressed("ui_left"):
		snake.set_next_direction(Vector2(-1, 0))
	elif Input.is_action_pressed("ui_down"):
		snake.set_next_direction(Vector2(0, 1))
	elif Input.is_action_pressed("ui_up"):
		snake.set_next_direction(Vector2(0, -1))

	# Timer untuk gerak
	move_timer += delta
	if move_timer >= MOVE_SPEED:
		snake.move_snake()
		move_timer = 0.0
		snake.queue_redraw()
